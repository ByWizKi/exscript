# ============================================================================
# Google OAuth Configuration
# Create credentials at: https://console.cloud.google.com
# ============================================================================
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================================================
# NextAuth Configuration
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ============================================================================
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3011

# ============================================================================
# Backend JWT Configuration
# Generate JWT_SECRET with: openssl rand -base64 32
# ============================================================================
JWT_SECRET=generate-with-openssl-rand-base64-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ============================================================================
# API URLs
# NEXT_PUBLIC_API_URL: Used by frontend to call the API (client-side)
# INTERNAL_API_URL: Used by Next.js server-side to call the API (Docker-only)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8011
INTERNAL_API_URL=http://api:8011

# ============================================================================
# Environment Configuration
# Set to "production" to disable OpenAPI docs (/docs, /redoc)
# Default: "development"
# ============================================================================
ENVIRONMENT=development

# ============================================================================
# Database Configuration (typically set in docker-compose.yml)
# Only needed if running backend outside Docker
# ============================================================================
# DATABASE_URL=postgresql+asyncpg://exscript:exscript@localhost:5435/exscript

# ============================================================================
# API Key Encryption (Fernet)
# Optional: Encrypt API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================================
ENCRYPTION_KEY=

# ============================================================================
# CORS Configuration
# Comma-separated list of allowed origins (default: http://localhost:3011)
# ============================================================================
CORS_ORIGINS=http://localhost:3011
